{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KMJ",
  "version": "0.1.1",
  "identifier": "com.kmj.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "python3 -m http.server 1420 --directory ../ui"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KMJ",
        "width": 950,
        "height": 700,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
